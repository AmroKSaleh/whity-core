{
  "name": "whity-render-service",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side PDF export microservice for whity-core (ADR 0012). Prints the document editor's documents (flowing, paginated in headless Chromium) and label sheets.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:info": "node scripts/write-build-info.js",
    "build:browser-info": "node scripts/write-browser-info.js",
    "start": "npm run build:info && node src/server.js",
    "test": "jest",
    "flow:fixture": "node scripts/generate-flow-fixture.js",
    "flow:verify": "node scripts/verify-flow-pdf.js",
    "flow:geometry": "node scripts/check-flow-rtl-geometry.js"
  },
  "dependencies": {
    "bwip-js": "^4.11.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "katex": "^0.19.1",
    "puppeteer-core": "^25.16.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "pdfjs-dist": "^6.4.299",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "basic-ftp": "^6.2.1"
  }
}

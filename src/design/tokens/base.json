{
  "name": "Whity Core Design Tokens",
  "description": "Master design token definitions for web, mobile, and desktop platforms, at tokens v3 (docs/design/tokens.json, design system 2.2). This file is the single source of truth for code — run `npm run tokens:generate` to regenerate all platform outputs (web globals.css, tokens.json, tokens.dart). Every value traces to docs/design/00-decision-register.md; change the register first.",
  "version": "3.0.0",
  "platforms": {
    "web": {
      "type": "css-custom-properties",
      "location": "../../../web/app/globals.css",
      "description": "CSS variables used by Tailwind CSS v4 and shadcn-ui components. The :root / .dark / typography blocks are generated between AUTO-GENERATED sentinel markers."
    },
    "mobile": {
      "type": "dart-constants",
      "location": "./generated/tokens.dart",
      "description": "Dart constants for Flutter Material Design 3 integration"
    },
    "flutter": {
      "type": "dart-constants",
      "location": "../../../flutter/whity_tokens/lib/src/generated/tokens.dart",
      "description": "Same Dart constants as \"mobile\", packaged as the flutter/whity_tokens git-dependency package for external Flutter client repos (see that package's README)."
    },
    "json": {
      "type": "json",
      "location": "./generated/tokens.json",
      "description": "Flat JSON export for programmatic / white-label tooling consumption"
    },
    "tokensPackage": {
      "type": "npm-package",
      "location": "../../../packages/tokens/generated/{tokens.json,theme.css}",
      "description": "@amroksaleh/tokens — standalone, Next.js-independent JSON + Tailwind v4 theme CSS for non-Next clients (Tauri/Vite SPAs, etc.)."
    }
  },

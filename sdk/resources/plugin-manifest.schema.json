{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whity.dev/schemas/plugin-manifest/1.json",
  "title": "Whity plugin manifest (plugin.json)",
  "description": "Format whity.plugin/1, SDK 1.47 (records: 1.50). Whity\\Sdk\\Manifest\\ManifestValidator is authoritative: it also checks references (a role grants only declared permissions, a screen is gated by one, a data type lives in a declared tenant table) and runs each screen's blocks through the block contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "plugin"
  ],
  "properties": {
    "manifest": {
      "const": "whity.plugin/1"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "label"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sdk": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "string",
          "minLength": 1
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "label"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "parent": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "permission",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "permission": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "number"
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "type"
              ]
            }
          }
        }
      }
    },
    "tables": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}$"
      },
      "additionalProperties": {
        "enum": [
          "tenant",
          "global"
        ]
      }
    },
    "dataTypes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "table"
        ],
        "properties": {
          "table": {
            "type": "string"
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "type",
          "default",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "type": {
            "enum": [
              "bool",
              "int"
            ]
          },
          "default": {
            "type": [
              "boolean",
              "integer"
            ]
          },
          "description": {
            "$ref": "#/$defs/description"
          },
          "period": {
            "enum": [
              "day",
              "week",
              "month"
            ]
          }
        }
      }
    },
    "records": {
      "description": "Record types kept in the host's shared record store (SDK 1.50). Fields, an optional lifecycle, and read/create/edit/delete permissions that the manifest declares.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "fields",
          "permissions"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "titleField": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "label"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "long_text",
                    "number",
                    "money",
                    "date",
                    "datetime",
                    "boolean",
                    "choice",
                    "multi_choice",
                    "person",
                    "ou",
                    "record"
                  ]
                },
                "label": {
                  "$ref": "#/$defs/label"
                },
                "required": {
                  "type": "boolean"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "record": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "value",
                      "label"
                    ],
                    "properties": {
                      "value": {
                        "type": "string"
                      },
                      "label": {
                        "$ref": "#/$defs/label"
                      }
                    }
                  }
                }
              }
            }
          },
          "lifecycle": {
            "type": "object",
            "required": [
              "states",
              "initial"
            ],
            "properties": {
              "states": {
                "type": "array"
              },
              "initial": {
                "type": "string"
              },
              "moves": {
                "type": "object"
              }
            }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "read",
              "create",
              "edit",
              "delete"
            ],
            "properties": {
              "read": {
                "type": "string"
              },
              "create": {
                "type": "string"
              },
              "edit": {
                "type": "string"
              },
              "delete": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "ar"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "ar": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}

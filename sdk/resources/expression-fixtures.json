{
  "about": "Shared fixtures for the manifest expression language (WHIT-759). Whity\\Sdk\\Expression\\Expression (PHP) and @whity-org/features/expressions (TypeScript) must both pass every case. 'evaluate' cases give an expression, a context and either 'expect' (the value) or 'error' (the ExpressionError kind). 'invalid' cases must fail validation with an error containing 'error'.",
  "context": {
    "fields": {
      "customer": "Example Bakery",
      "cake_type": "wedding",
      "weight_kg": 2.5,
      "price": 50000,
      "deposit": 15000,
      "pickup_on": "2026-11-03",
      "notes": null,
      "tags": ["nuts", "vegan"],
      "lines": [
        { "item": "tier", "qty": 3, "unit_price": 12500 },
        { "item": "topper", "qty": 1, "unit_price": 6500 },
        { "item": "box", "qty": 1, "unit_price": 0 }
      ]
    },
    "state": "draft",
    "roles": ["baker", "shop_manager"],
    "today": "2026-10-31",
    "now": "2026-10-31T09:30:00Z"
  },
  "evaluate": [
    { "name": "literal number", "expr": 42, "expect": 42 },
    { "name": "literal text", "expr": "hello", "expect": "hello" },
    { "name": "field", "expr": { "field": "price" }, "expect": 50000 },
    { "name": "field in list form", "expr": { "field": ["deposit"] }, "expect": 15000 },
    { "name": "missing field is null", "expr": { "field": "colour" }, "expect": null },
    { "name": "state", "expr": { "state": [] }, "expect": "draft" },
    { "name": "today", "expr": { "today": [] }, "expect": "2026-10-31" },
    { "name": "now", "expr": { "now": [] }, "expect": "2026-10-31T09:30:00Z" },
    { "name": "has role", "expr": { "has_role": "shop_manager" }, "expect": true },
    { "name": "lacks role", "expr": { "has_role": "owner" }, "expect": false },

    { "name": "deposit is at least 30% of price", "expr": { ">=": [{ "field": "deposit" }, { "*": [{ "field": "price" }, 0.3] }] }, "expect": true },
    { "name": "balance", "expr": { "-": [{ "field": "price" }, { "field": "deposit" }] }, "expect": 35000 },
    { "name": "negate", "expr": { "-": [5] }, "expect": -5 },
    { "name": "sum of args", "expr": { "+": [1, 2, 3.5] }, "expect": 6.5 },
    { "name": "product", "expr": { "*": [2, 3, 4] }, "expect": 24 },
    { "name": "division", "expr": { "/": [7, 2] }, "expect": 3.5 },
    { "name": "division by zero is null", "expr": { "/": [7, 0] }, "expect": null },
    { "name": "arithmetic with null is null", "expr": { "+": [{ "field": "notes" }, 1] }, "expect": null },
    { "name": "min", "expr": { "min": [3, 1, 2] }, "expect": 1 },
    { "name": "max", "expr": { "max": [3, 1, 2] }, "expect": 3 },
    { "name": "round half away from zero", "expr": { "round": [2.5] }, "expect": 3 },
    { "name": "round negative half away from zero", "expr": { "round": [-2.5] }, "expect": -3 },
    { "name": "round to digits", "expr": { "round": [1.2345, 2] }, "expect": 1.23 },
    { "name": "round money after a fraction", "expr": { "round": [{ "*": [{ "field": "price" }, 0.15] }] }, "expect": 7500 },
    { "name": "abs", "expr": { "abs": [-4] }, "expect": 4 },
    { "name": "floating point is IEEE in both", "expr": { "+": [0.1, 0.2] }, "expect": 0.30000000000000004 },

    { "name": "and", "expr": { "and": [true, { "==": [{ "state": [] }, "draft"] }] }, "expect": true },
    { "name": "and short-circuits", "expr": { "and": [false, { "<": ["a", 1] }] }, "expect": false },
    { "name": "or", "expr": { "or": [false, null, true] }, "expect": true },
    { "name": "not", "expr": { "not": [false] }, "expect": true },
    { "name": "null condition is false", "expr": { "not": [{ "field": "notes" }] }, "expect": true },
    { "name": "if picks first true branch", "expr": { "if": [false, "a", true, "b", "c"] }, "expect": "b" },
    { "name": "if falls through to otherwise", "expr": { "if": [false, "a", "c"] }, "expect": "c" },
    { "name": "condition must be boolean", "expr": { "and": [1] }, "error": "type" },

    { "name": "int equals float", "expr": { "==": [1, 1.0] }, "expect": true },
    { "name": "number is not text", "expr": { "==": [1, "1"] }, "expect": false },
    { "name": "null equals null", "expr": { "==": [{ "field": "notes" }, null] }, "expect": true },
    { "name": "not equal", "expr": { "!=": [{ "field": "cake_type" }, "birthday"] }, "expect": true },
    { "name": "lists compare deeply", "expr": { "==": [{ "field": "tags" }, { "list": ["nuts", "vegan"] }] }, "expect": true },
    { "name": "less than", "expr": { "<": [1, 2] }, "expect": true },
    { "name": "at most", "expr": { "<=": [2, 2] }, "expect": true },
    { "name": "more than", "expr": { ">": [1, 2] }, "expect": false },
    { "name": "dates order as text", "expr": { "<": [{ "today": [] }, { "field": "pickup_on" }] }, "expect": true },
    { "name": "ordering with null is false", "expr": { ">": [{ "field": "notes" }, 0] }, "expect": false },
    { "name": "ordering text against number is a type error", "expr": { "<": ["a", 1] }, "error": "type" },

    { "name": "concat", "expr": { "concat": ["Order for ", { "field": "customer" }] }, "expect": "Order for Example Bakery" },
    { "name": "concat writes numbers like JavaScript", "expr": { "concat": [{ "field": "weight_kg" }, " kg, ", 3, " tiers"] }, "expect": "2.5 kg, 3 tiers" },
    { "name": "concat with null is null", "expr": { "concat": ["x", { "field": "notes" }] }, "expect": null },
    { "name": "contains text", "expr": { "contains": [{ "field": "customer" }, "Bakery"] }, "expect": true },
    { "name": "contains in list", "expr": { "contains": [{ "field": "tags" }, "vegan"] }, "expect": true },
    { "name": "starts with", "expr": { "starts_with": [{ "field": "customer" }, "Example"] }, "expect": true },
    { "name": "ends with", "expr": { "ends_with": [{ "field": "customer" }, "Shop"] }, "expect": false },
    { "name": "length counts characters", "expr": { "length": ["مخبز"] }, "expect": 4 },
    { "name": "length of a list", "expr": { "length": [{ "field": "lines" }] }, "expect": 3 },
    { "name": "lower", "expr": { "lower": ["Example"] }, "expect": "example" },
    { "name": "upper", "expr": { "upper": ["Example"] }, "expect": "EXAMPLE" },
    { "name": "text op on a number is a type error", "expr": { "starts_with": [5, "5"] }, "error": "type" },

    { "name": "add days across a month", "expr": { "add_days": [{ "today": [] }, 3] }, "expect": "2026-11-03" },
    { "name": "subtract days", "expr": { "add_days": ["2026-03-01", -1] }, "expect": "2026-02-28" },
    { "name": "days between", "expr": { "days_between": [{ "today": [] }, { "field": "pickup_on" }] }, "expect": 3 },
    { "name": "days between backwards", "expr": { "days_between": ["2026-11-03", "2026-10-31"] }, "expect": -3 },
    { "name": "not a real date", "expr": { "add_days": ["2026-02-30", 1] }, "error": "type" },
    { "name": "fractional days", "expr": { "add_days": ["2026-10-31", 1.5] }, "error": "type" },

    { "name": "in", "expr": { "in": [{ "field": "cake_type" }, { "list": ["wedding", "custom"] }] }, "expect": true },
    { "name": "in null list is false", "expr": { "in": ["x", { "field": "notes" }] }, "expect": false },
    { "name": "any", "expr": { "any": [{ "field": "lines" }, { "==": [{ "item": "item" }, "topper"] }] }, "expect": true },
    { "name": "all", "expr": { "all": [{ "field": "lines" }, { ">": [{ "item": "qty" }, 0] }] }, "expect": true },
    { "name": "all of nothing is true", "expr": { "all": [{ "field": "notes" }, false] }, "expect": true },
    { "name": "count", "expr": { "count": [{ "field": "lines" }] }, "expect": 3 },
    { "name": "count where", "expr": { "count": [{ "field": "lines" }, { ">": [{ "item": "unit_price" }, 0] }] }, "expect": 2 },
    { "name": "sum of line totals", "expr": { "sum": [{ "field": "lines" }, { "*": [{ "item": "qty" }, { "item": "unit_price" }] }] }, "expect": 44000 },
    { "name": "item itself", "expr": { "any": [{ "field": "tags" }, { "==": [{ "item": [] }, "nuts"] }] }, "expect": true },
    { "name": "item of a non-object is null", "expr": { "any": [{ "field": "tags" }, { "==": [{ "item": "x" }, null] }] }, "expect": true },
    { "name": "list op on text is a type error", "expr": { "count": [{ "field": "customer" }] }, "error": "type" },
    { "name": "is empty null", "expr": { "is_empty": [{ "field": "notes" }] }, "expect": true },
    { "name": "is empty text", "expr": { "is_empty": [""] }, "expect": true },
    { "name": "is empty list", "expr": { "is_empty": [{ "list": [] }] }, "expect": true },
    { "name": "is not empty", "expr": { "is_empty": [{ "field": "tags" }] }, "expect": false },
    { "name": "coalesce", "expr": { "coalesce": [{ "field": "notes" }, { "field": "colour" }, "none"] }, "expect": "none" },

    { "name": "evaluation budget", "expr": { "sum": [{ "field": "big" }, { "+": [{ "item": [] }, { "item": [] }, { "item": [] }] }] }, "context": { "fields": { "big": "BIG_LIST_4000" } }, "error": "budget" }
  ],
  "invalid": [
    { "name": "bare list", "expr": [1, 2], "error": "a bare list isn't an expression" },
    { "name": "two keys", "expr": { "+": [1], "-": [1] }, "error": "exactly one key" },
    { "name": "unknown operator", "expr": { "eval": ["x"] }, "error": "unknown operator \"eval\"" },
    { "name": "arity", "expr": { "/": [1] }, "error": "takes 2 argument(s), got 1" },
    { "name": "if needs an otherwise", "expr": { "if": [true, 1, false, 2] }, "error": "an odd count" },
    { "name": "field name", "expr": { "field": "Price; DROP" }, "error": "a field name" },
    { "name": "field name must be literal", "expr": { "field": [{ "field": "x" }] }, "error": "a field name" },
    { "name": "item outside a list operator", "expr": { "item": "qty" }, "error": "only inside any, all, count or sum" },
    { "name": "item in the list argument itself", "expr": { "any": [{ "item": [] }, true] }, "error": "only inside any, all, count or sum" },
    { "name": "round digits", "expr": { "round": [1.5, 9] }, "error": "digits must be a whole number from 0 to 6" },
    { "name": "too deep", "expr": "DEEP_25", "error": "nested deeper than 24" },
    { "name": "too many nodes", "expr": "WIDE_300", "error": "more than 256 nodes" },
    { "name": "long text", "expr": "LONG_TEXT_1001", "error": "text longer than 1000 characters" }
  ]
}

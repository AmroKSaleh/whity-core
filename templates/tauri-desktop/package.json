{
  "name": "whity-tauri-desktop-template",
  "private": true,
  "version": "0.2.0",
  "description": "Boilerplate Tauri v2 desktop app consuming @whity-org/ui + @whity-org/features. Start here, then add crates for native capabilities (see src-tauri/src/commands/printer.rs for a worked example).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@whity-org/features": "file:../../packages/features",
    "@whity-org/tokens": "file:../../packages/tokens",
    "@whity-org/ui": "file:../../packages/ui",
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.49.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "katex": "^0.19.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.5"
  }
}

{
  "name": "whity-tauri-desktop-template",
  "private": true,
  "version": "0.2.0",
  "description": "Boilerplate Tauri v2 desktop app consuming @amroksaleh/ui + @amroksaleh/features. Start here, then add crates for native capabilities (see src-tauri/src/commands/printer.rs for a worked example).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@amroksaleh/features": "file:../../packages/features",
    "@amroksaleh/tokens": "file:../../packages/tokens",
    "@amroksaleh/ui": "file:../../packages/ui",
    "@hookform/resolvers": "^5.9.1",
    "@tabler/icons-react": "^3.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "katex": "^0.18.7",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}

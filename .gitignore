/vendor/
.DS_Store
*.swp
*.swo
.env
.env.local
# Staging secrets (WC-32); commit .env.staging.example only.
.env.staging
.idea/
.vscode/
node_modules/
dist/
build/

# Docs: only wiki and ADRs should be committed
docs/*
!docs/wiki/
!docs/adr/
.worktrees/
.phpunit.cache/
# PHPStan result cache (project-local tmpDir; restored across CI runs for a fast
# incremental re-analysis — see phpstan.neon and .github/workflows/automated-tests.yml)
/.phpstan-cache/

.claude/
.tasker/
.playwright-mcp/
tests/Local/
docker-compose.override.yml
/storage/

# Infection mutation-testing run artifacts (regenerated each run; uploaded as CI artifacts)
/infection-log.txt
/infection-summary.txt

# Storybook build output (regenerated; never committed)
storybook-static/
phpunit_full.log
.phpunit-sqlite.log
.phpunit-full.log
.phpstan.log
.phpunit-pg.log
.phpunit-pg-int.log

# PHPUnit clover report (regenerated by every coverage run; CI uploads it as an
# artifact and scripts/ci-local.sh deletes it afterwards — but a `git add -A`
# mid-run would otherwise commit 37k lines of it).
/coverage.xml

# Bytecode from the python CI helpers (scripts/ci-mutation-gate.py). Running one
# locally leaves it behind, and a `git add -A` would otherwise commit it.
__pycache__/

# The backend's build identity (#1049), written by
# scripts/write-build-identity.php at image-build time and read at boot by
# BuildIdentity for GET /api/build. NEVER committed: a tracked copy would be a
# constant that moves with the source whether or not the source was deployed,
# which is the exact failure /api/build exists to detect.
/build-identity.json

# Child-process probe scripts written at the repository root by
# EntryPointServiceWiringRealBootTest, which boots public/index.php and
# BaseCommand::setupKernel() out-of-process. Its tearDown() unlinks them, so
# these only survive a run that was KILLED — and then they sit at the root
# looking exactly like source, which is how one of them nearly reached a commit.
/.whity-probe-*.php

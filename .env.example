APP_ENV=development
DB_USER=whity
DB_PASSWORD=whity_dev
DB_NAME=whity_core
DB_HOST=postgres
DB_PORT=5432
# JWT signing secret. Required (and must be >= 32 chars) outside APP_ENV=development.
JWT_SECRET=dev_secret_key_change_in_production
# AES-256-CBC key used to encrypt stored TOTP 2FA secrets (WC-95). Required (and must
# be >= 32 chars) outside APP_ENV=development; in development the app falls back to an
# insecure hardcoded default. Must match the value used when secrets were originally
# stored — changing it invalidates all existing 2FA enrollments.
ENCRYPTION_KEY=dev_encryption_key_change_in_production
# Comma-separated CORS origin allowlist. The matching request Origin is reflected
# back (with credentials); never a wildcard. Defaults to http://localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend links (headless) ────────────────────────────────────────────────
# The backend hands people links into frontend pages (emails, SSO redirects,
# public forms, QR verification, error alerts). APP_URL is the backend's own
# public origin (the SSO callback is built on it). FRONTEND_URL is where pages
# are served; unset, it is APP_URL, which is right when the bundled admin is
# served from the same address. Set it when you run your own frontend elsewhere.
# FRONTEND_URL=https://app.example.com
#
# Each link can also be pointed at a full URL prefix of your own, for a frontend
# whose routes differ from the bundled admin's. Unset = FRONTEND_URL + the path
# shown. The token / slug / id is appended to the prefix.
# EMAIL_VERIFICATION_URL=     # /verify-email
# PASSWORD_RESET_URL=         # /reset-password
# TWO_FACTOR_RECOVERY_URL=    # /account-recovery
# INVITATION_ACCEPT_URL=      # /accept-invitation
# SSO_SUCCESS_URL=            # /dashboard
# SSO_LOGIN_URL=              # /login  (?sso=select / ?sso_error=<reason> appended)
# PUBLIC_FORM_URL=            # /f/{slug}
# DOCUMENT_VERIFY_URL=        # /verify/{token}
# ERROR_DETAILS_URL=          # /admin/errors/{id}  (WHITY_PUBLIC_URL still honoured)
# Maximum accepted API request-body size in bytes (WC-189). Bodies larger than
# this are rejected with a generic 400 before any parsing. Defaults to 1 MiB
# (1048576). A non-positive/non-numeric value falls back to the default.
MAX_REQUEST_BODY_BYTES=1048576
# Initial account passwords used during seeding/migration. If left unset, a random
# password is generated and printed ONCE to stdout/log so a fresh install is
# recoverable. There is no hardcoded fallback.
#
# These apply only when the account is CREATED. Setting one for an account that
# already exists does nothing — the seeder never rewrites a live credential — but
# it will tell you so rather than leave the value silently inert. Change an
# existing password through the admin UI instead.
INITIAL_ADMIN_PASSWORD=
INITIAL_USER_PASSWORD=
INITIAL_SYSTEM_ADMIN_PASSWORD=
# Seeds the system-tenant (id 0) superuser superuser@example.com — a system-tenant
# admin that can manage the global base roles and every tenant.
# Demo accounts (admin@/user@/superuser@example.com) are seeded ONLY under
# APP_ENV=development; elsewhere they need `seed --with-fixtures`.
INITIAL_SUPERUSER_PASSWORD=
# Shared password for the eight @demo.example.com accounts the DOCUMENT DEMO
# dataset creates (a faculty, its departments, and the people the seeded routes
# reach). Its OWN gate, not the one above: `seed --with-document-demo`, off by
# default in every environment including development, because nothing depends on
# demo content and a CI stack booting in "development" does not want it. One
# variable for all eight deliberately — the whole point of those logins is to
# sign in as one person and then another and compare what they see, and eight
# variables to do that is eight reasons not to.
DEMO_SEED_PASSWORD=
# Address of the BOOTSTRAP administrator — the system-tenant (id 0) account an
# operator first signs in with. Defaults to system@whity.local, which is
# unroutable (no password reset, no verification mail can ever reach it) and
# names the vendor rather than you. Set this to a real mailbox you control BEFORE
# the first `migrate run`, and the account is created there.
#
# On an install that already exists, setting it and re-running `migrate run` (or
# `seed`) MOVES the existing account to the new address — same profile, same
# password, same tenant-0 admin membership. It only ever moves an account off the
# default; renaming it a second time is `PATCH /api/users/{id}`'s job.
INITIAL_SYSTEM_ADMIN_EMAIL=

# Document/label designer server-side render tier (ADR 0012). The separate
# `whity_render` Docker service (Node + Puppeteer/headless Chromium, opt-in
# `render` compose profile) this core service calls over internal HTTP.
# RENDER_SERVICE_URL is the in-network base URL (the compose service name
# resolves it; only override for a non-default topology).
# RENDER_SHARED_SECRET authenticates core -> render calls (X-Render-Secret
# header) and MUST match the same value configured on the render service
# itself; must be >= 32 chars, like JWT_SECRET/ENCRYPTION_KEY. Also gated by
# the documents.render_enabled global setting (default off) — this env var
# alone does not turn the feature on.
RENDER_SERVICE_URL=http://render:8130
RENDER_SHARED_SECRET=

# ── Buying a subscription ────────────────────────────────────────────────────
# whity-core does not take money and holds no gateway credentials. A separate
# service does, and knows nothing about tenants, features or permissions — only
# an opaque id we hand it. The relationship is two questions: where to send a
# tenant to pay, and whether a tenant may use paid features.
#
# LEAVE THESE EMPTY AND NOTHING BREAKS. An unconfigured deployment sells no
# subscriptions and walls nobody, which is the correct behaviour for a
# self-hosted installation that bills its users some other way or not at all.
#
# THEY ARE ENVIRONMENT VARIABLES, NOT SETTINGS, deliberately: settings live in
# the database, are readable through an API by anyone holding the right
# permission, and are dumped into every backup. A signing secret that can be
# read is a signing secret that can be used.
#
# PAY_WEBHOOK_SECRET verifies inbound notifications. It is the ONLY thing
# authenticating that endpoint — there is no session behind it — so an empty
# value makes every delivery be refused rather than trusted.
PAY_BASE_URL=
PAY_API_KEY=
PAY_WEBHOOK_SECRET=
# Bounded, because an unbounded wait on a third party is an outage of our own.
PAY_TIMEOUT_SECONDS=10
# How far the sender's clock may be from ours before a delivery is treated as a
# replay. Their retries are re-signed with a fresh timestamp, so this does not
# interfere with them.
PAY_WEBHOOK_TOLERANCE_SECONDS=300

# MCP sign-in (ADR-0015). The OAuth 2.1 authorization server that AI apps such
# as Claude and ChatGPT sign in with: its issuer URL. Unset = no OAuth; apps
# connect with tokens from the "Connect an AI app" wizard as before. Needs
# APP_URL, because the protected resource is APP_URL + /mcp.
# MCP_OAUTH_ISSUER=https://auth.example.com
